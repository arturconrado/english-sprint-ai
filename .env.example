APP_ENV=development
DATABASE_URL=postgresql://english_sprint:english_sprint@localhost:5432/english_sprint
REDIS_URL=redis://localhost:6379/0
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO
REALTIME_ENABLED=false
REALTIME_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe-2025-12-15
INSTALLATION_HASH_SECRET=
REALTIME_CREATE_TIMEOUT_SECONDS=15
REALTIME_SIDEBAND_TIMEOUT_SECONDS=10
REALTIME_HANGUP_TIMEOUT_SECONDS=5
REALTIME_MAX_DURATION_SECONDS=1800
REALTIME_REDIS_TTL_SECONDS=2100
REALTIME_RATE_LIMIT_PER_HOUR=10
REALTIME_VAD_THRESHOLD=0.55
REALTIME_VAD_PREFIX_PADDING_MS=300
REALTIME_VAD_SILENCE_DURATION_MS=600
PEDAGOGY_ENABLED=false
INTERNAL_API_TOKEN=
PEDAGOGICAL_EVALUATION_MODEL=gpt-5.4-mini-2026-03-17
MISSION_SUMMARY_MODEL=gpt-5.4-mini-2026-03-17
PEDAGOGY_SESSION_TOKEN_DAYS=35
PEDAGOGY_IDEMPOTENCY_TTL_SECONDS=300
PEDAGOGY_CONTENT_TTL_SECONDS=3600
CONTENT_RETENTION_ENABLED=false
CONTENT_RETENTION_DAYS=30
CONTENT_ENCRYPTION_KEY=
CONTENT_ENCRYPTION_KEY_VERSION=v1
