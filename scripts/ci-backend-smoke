#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BACKEND="${PROJECT_ROOT}/backend"
PORT="${PORT:-8000}"

cd "${BACKEND}"
uv run alembic upgrade head
uv run uvicorn english_sprint_api.main:app --app-dir src --host 127.0.0.1 --port "${PORT}" &
SERVER_PID=$!

cleanup() {
  kill "${SERVER_PID}" 2>/dev/null || true
}
trap cleanup EXIT

for _ in $(seq 1 30); do
  if curl --fail --silent "http://127.0.0.1:${PORT}/healthz" >/dev/null; then
    break
  fi
  sleep 1
done

curl --fail --show-error --silent "http://127.0.0.1:${PORT}/healthz"
curl --fail --show-error --silent "http://127.0.0.1:${PORT}/readyz"
