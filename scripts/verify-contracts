#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

cd "${PROJECT_ROOT}"
npm run lint:openapi
./scripts/generate-contracts
./scripts/generate-pedagogy
git diff --exit-code -- \
  backend/src/generated \
  backend/src/english_sprint_api/pedagogy/generated_state.py \
  contracts/openapi.yaml \
  contracts/pedagogy \
  shared/src
